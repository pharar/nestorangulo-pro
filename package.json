{
  "name": "nestorangulo-pro",
  "type": "module",
  "version": "0.9.5",
  "private": true,
  "description": "Personal authority site for Nestor Angulo de Ugarte — Head of Security, CISSP, security program builder.",
  "author": {
    "name": "Nestor Angulo de Ugarte",
    "email": "hello@nestorangulo.pro",
    "url": "https://nestorangulo.pro"
  },
  "homepage": "https://nestorangulo.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/pharar/nestorangulo-pro.git"
  },
  "license": "MIT",
  "keywords": [
    "security",
    "cissp",
    "security-programs",
    "incident-response",
    "vulnerability-intelligence",
    "astro",
    "personal-site"
  ],
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:urls": "node scripts/check-urls.mjs",
    "check:ai": "node scripts/check-ai-layer.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:content": "node scripts/check-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/",
    "gate": "node scripts/gate.mjs",
    "og": "node scripts/build-og.mjs",
    "housekeeping": "node scripts/housekeeping.mjs report",
    "housekeeping:baseline": "node scripts/housekeeping.mjs baseline",
    "housekeeping:verify": "node scripts/housekeeping.mjs verify",
    "housekeeping:probe-ts": "node scripts/housekeeping.mjs probe-ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@astrojs/check": {
      "typescript": "$typescript"
    }
  }
}
