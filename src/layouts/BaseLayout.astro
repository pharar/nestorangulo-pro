---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PageStructuredData } from '../lib/structuredData';
import { langFromUrl } from '../i18n/utils';

// Fontsource: self-hosted, no external requests
import '@fontsource-variable/fraunces'; // wght axis, normal
import '@fontsource-variable/fraunces/wght-italic.css'; // wght axis, italic
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
// Montserrat: the wordmark face in the inlined logo (see Header.astro)
import '@fontsource/montserrat/300.css';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Pass null to omit the canonical entirely (see 404.astro). */
  canonical?: string | null;
  ogImage?: string;
  person?: boolean;
  /**
   * Content language of this page (`<html lang>`, og:locale, JSON-LD
   * inLanguage). Defaults to the route's locale; a Spanish-language talk on
   * the English route passes its own.
   */
  lang?: string;
  /**
   * Does the equivalent page exist in the other language? Drives hreflang
   * alternates, og:locale:alternate and where the language switch points.
   * Pass false for e.g. an essay without a translation, and on the 404.
   */
  hasAlternate?: boolean;
  /** Forwarded to SEO.astro: this page's JSON-LD @graph contribution. */
  structuredData?: PageStructuredData;
}

const {
  title,
  description,
  canonical,
  ogImage,
  person = false,
  lang: contentLang,
  hasAlternate = true,
  structuredData,
} = Astro.props;

// Route locale (chrome language) vs content language (usually the same).
const locale = langFromUrl(Astro.url);
const lang = contentLang ?? locale;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {/* Theme: must run before first paint, so it is render-blocking and lives in
        public/ rather than inline — Astro does not hash `is:inline` scripts, and
        security.csp in astro.config.mjs only allows script-src 'self'. */}
    <script src="/theme-init.js" is:inline></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The .ico must be sizes="32x32", not "any": with "any", Chrome prefers it
        over the SVG, and only the SVG follows prefers-color-scheme. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      person={person}
      lang={lang}
      locale={locale}
      hasAlternate={hasAlternate && canonical !== null}
      structuredData={structuredData}
    />
    <slot name="head" />
  </head>
  <body>
    <Header lang={locale} hasAlternate={hasAlternate && canonical !== null} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={locale} />
  </body>
</html>
