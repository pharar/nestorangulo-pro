---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lead from '../components/Lead.astro';
import { SITE_URL } from '../config';
import { contacts } from '../data/contacts';
import { useContact } from '../i18n/ui/contact';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/config';

// Contact page markup for every language (see Home.astro for the pattern).
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useContact(lang);
---

<BaseLayout
  lang={lang}
  title={t('title')}
  description={t('description')}
  structuredData={{
    type: 'ContactPage',
    breadcrumbs: [{ name: t('breadcrumb'), url: `${SITE_URL}${localizePath('/contact/', lang)}` }],
  }}
>
  <div class="container">
    <div class="page-header">
      <h1>
        {t('h1')}
        <span class="caret" aria-hidden="true">
          _
        </span>
      </h1>
      <Lead text={t('intro')} />
    </div>

    <ul class="contact-list">
      {contacts.map(({ label, href, display, note, external }) => (
        <li class="contact-item">
          <span class="contact-label">{label}</span>
          <div class="contact-value">
            <a
              href={href}
              class="contact-link"
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {display}
            </a>
            {note && <span class="contact-note">{t(note)}</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
