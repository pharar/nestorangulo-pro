---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config';
---

<BaseLayout
  title="Writing — Nestor Angulo de Ugarte"
  description="Essays on security program design, vulnerability intelligence, incident response, and organizational security practice."
  structuredData={{
    type: 'CollectionPage',
    breadcrumbs: [{ name: 'Writing', url: `${SITE_URL}/writing/` }],
  }}
>
  <div class="container">
    <div class="page-header">
      <h1>Writing</h1>
      <p>
        Essays on security program design, vulnerability intelligence, and operational practice.
      </p>
    </div>
    <div class="placeholder">
      <p class="placeholder-status">Coming next.</p>
      <a href="/" class="back-link">
        ← Back to home
      </a>
    </div>
  </div>
</BaseLayout>
