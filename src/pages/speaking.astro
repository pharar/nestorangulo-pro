---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config';

const allTalks = await getCollection('talks');
const talks = allTalks
  .filter((t) => !t.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = talks.filter((t) => t.data.featured);
const rest = talks.filter((t) => !t.data.featured);

const byYear: Record<string, CollectionEntry<'talks'>[]> = {};
for (const talk of rest) {
  const year = String(talk.data.date.getFullYear());
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(talk);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

function isoDate(d: Date): string {
  return d.toISOString().slice(0, 10);
}

const FORMAT_LABELS: Record<string, string> = {
  'conference-talk': 'Conference Talk',
  'meetup-talk': 'Meetup Talk',
  'panel': 'Panel',
  'podcast': 'Podcast',
  'webinar': 'Webinar',
  'ama': 'AMA',
  'workshop': 'Workshop',
};
---

<BaseLayout
  title="Speaking — Nestor Angulo de Ugarte"
  description={`${talks.length} conference appearances on web security, vulnerability intelligence, software supply chain, and security culture.`}
  canonical={`${SITE_URL}/speaking`}
>
  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="about-hero" aria-labelledby="speaking-h1">
    <div class="container">
      <h1 class="about-h1" id="speaking-h1">Speaking<span class="caret" aria-hidden="true">_</span></h1>
      <p class="about-tagline">web security · vulnerability intelligence · software supply chain · security culture</p>
      <p class="talks-intro">
        {talks.length} appearances at WordCamps, industry conferences, podcasts, and webinars
        spanning web security, vulnerability intelligence, software supply chain, and security
        culture — across Europe and Japan.
      </p>
      <!-- JS injects the filter bar + count here; no-JS: empty, no space taken -->
      <div id="talks-filter-bar"></div>
    </div>
  </section>

  <!-- ── Featured ──────────────────────────────────────────── -->
  {
    featured.length > 0 && (
      <section class="about-section" aria-labelledby="featured-heading" data-talks-section="featured">
        <div class="container">
          <h2 class="speaking-section-label talks-featured-heading" id="featured-heading">
            Featured
          </h2>
          <ul class="talks-featured-list">
            {featured.map((talk) =>
              talk.data.cover ? (
                <li class="talk-item talk-item--has-cover" data-themes={talk.data.themes.join('|')} data-featured="true">
                  <figure class="talk-card-cover">
                    <Image
                      src={talk.data.cover}
                      alt={talk.data.coverAlt ?? `${talk.data.title} — ${talk.data.event}`}
                      width={700}
                      loading="lazy"
                      class="talk-card-img"
                    />
                  </figure>
                  <div class="talk-card-content">
                    <div class="talk-top">
                      <a href={`/speaking/${talk.id}`} class="talk-title-link">
                        {talk.data.title}
                      </a>
                      <time class="talk-date" datetime={talk.data.date.toISOString()}>
                        {isoDate(talk.data.date)}
                      </time>
                    </div>
                    <p class="talk-meta">
                      {talk.data.event}
                      {talk.data.location ? ` · ${talk.data.location}` : ''}
                    </p>
                    <p class="talk-format">{FORMAT_LABELS[talk.data.format]}</p>
                    <ul class="talk-themes" aria-label="Themes">
                      {talk.data.themes.map((theme) => (
                        <li class="theme-tag">{theme}</li>
                      ))}
                    </ul>
                    {(talk.data.videoUrl || talk.data.slidesUrl || talk.data.eventUrl) && (
                      <div class="talk-links">
                        {talk.data.videoUrl && (
                          <a class="talk-link" href={talk.data.videoUrl} target="_blank" rel="noopener noreferrer">Video ↗</a>
                        )}
                        {talk.data.slidesUrl && (
                          <a class="talk-link" href={talk.data.slidesUrl} target="_blank" rel="noopener noreferrer">Slides ↗</a>
                        )}
                        {talk.data.eventUrl && (
                          <a class="talk-link" href={talk.data.eventUrl} target="_blank" rel="noopener noreferrer">Event ↗</a>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              ) : (
                <li class="talk-item" data-themes={talk.data.themes.join('|')} data-featured="true">
                  <div class="talk-top">
                    <a href={`/speaking/${talk.id}`} class="talk-title-link">
                      {talk.data.title}
                    </a>
                    <time class="talk-date" datetime={talk.data.date.toISOString()}>
                      {isoDate(talk.data.date)}
                    </time>
                  </div>
                  <p class="talk-meta">
                    {talk.data.event}
                    {talk.data.location ? ` · ${talk.data.location}` : ''}
                  </p>
                  <p class="talk-format">{FORMAT_LABELS[talk.data.format]}</p>
                  <ul class="talk-themes" aria-label="Themes">
                    {talk.data.themes.map((theme) => (
                      <li class="theme-tag">{theme}</li>
                    ))}
                  </ul>
                  {(talk.data.videoUrl || talk.data.slidesUrl || talk.data.eventUrl) && (
                    <div class="talk-links">
                      {talk.data.videoUrl && (
                        <a class="talk-link" href={talk.data.videoUrl} target="_blank" rel="noopener noreferrer">Video ↗</a>
                      )}
                      {talk.data.slidesUrl && (
                        <a class="talk-link" href={talk.data.slidesUrl} target="_blank" rel="noopener noreferrer">Slides ↗</a>
                      )}
                      {talk.data.eventUrl && (
                        <a class="talk-link" href={talk.data.eventUrl} target="_blank" rel="noopener noreferrer">Event ↗</a>
                      )}
                    </div>
                  )}
                </li>
              )
            )}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ── Archive by year ───────────────────────────────────── -->
  {
    years.length > 0 && (
      <section class="about-section" aria-labelledby="archive-heading" data-talks-section="archive">
        <div class="container">
          <h2 class="speaking-section-label" id="archive-heading">
            Archive
          </h2>
          {years.map((year) => (
            <div class="talks-year-group">
              <h3 class="talks-year-heading">{year}</h3>
              <ul class="talks-list">
                {byYear[year].map((talk) => (
                  <li class="talk-item" data-themes={talk.data.themes.join('|')}>
                    <div class="talk-top">
                      <a href={`/speaking/${talk.id}`} class="talk-title-link">
                        {talk.data.title}
                      </a>
                      <time class="talk-date" datetime={talk.data.date.toISOString()}>
                        {isoDate(talk.data.date)}
                      </time>
                    </div>
                    <p class="talk-meta">
                      {talk.data.event}
                      {talk.data.location ? ` · ${talk.data.location}` : ''}
                    </p>
                    <p class="talk-format">{FORMAT_LABELS[talk.data.format]}</p>
                    <ul class="talk-themes" aria-label="Themes">
                      {talk.data.themes.map((theme) => (
                        <li class="theme-tag">{theme}</li>
                      ))}
                    </ul>
                    {(talk.data.videoUrl || talk.data.slidesUrl || talk.data.eventUrl) && (
                      <div class="talk-links">
                        {talk.data.videoUrl && (
                          <a class="talk-link" href={talk.data.videoUrl} target="_blank" rel="noopener noreferrer">Video ↗</a>
                        )}
                        {talk.data.slidesUrl && (
                          <a class="talk-link" href={talk.data.slidesUrl} target="_blank" rel="noopener noreferrer">Slides ↗</a>
                        )}
                        {talk.data.eventUrl && (
                          <a class="talk-link" href={talk.data.eventUrl} target="_blank" rel="noopener noreferrer">Event ↗</a>
                        )}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const placeholder = document.getElementById('talks-filter-bar');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.talk-item[data-themes]'));

  if (placeholder && items.length) {
    const totalCount = items.length;
    const themeSet = new Set<string>();
    items.forEach((item) => {
      (item.dataset.themes ?? '').split('|').filter(Boolean).forEach((t) => themeSet.add(t));
    });
    const themes = [...themeSet].sort();

    const filterBar = document.createElement('div');
    filterBar.className = 'filter-bar';
    filterBar.setAttribute('role', 'group');
    filterBar.setAttribute('aria-label', 'Filter by theme');

    const makeChip = (label: string, theme: string, active: boolean): HTMLButtonElement => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'filter-chip';
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.dataset.theme = theme;
      btn.textContent = label;
      return btn;
    };

    // Order: All · Featured · themes…
    filterBar.appendChild(makeChip('All', 'all', true));
    filterBar.appendChild(makeChip('Featured', 'featured', false));
    themes.forEach((t) => filterBar.appendChild(makeChip(t, t, false)));

    const liveRegion = document.createElement('p');
    liveRegion.id = 'filter-count';
    liveRegion.className = 'filter-count';
    liveRegion.setAttribute('aria-live', 'polite');
    liveRegion.textContent = `Showing all ${totalCount} talks`;

    placeholder.appendChild(filterBar);
    placeholder.appendChild(liveRegion);

    const applyFilter = (theme: string) => {
      filterBar.querySelectorAll<HTMLElement>('.filter-chip').forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.dataset.theme === theme ? 'true' : 'false');
      });

      let visible = 0;
      items.forEach((item) => {
        const match =
          theme === 'all' ||
          (theme === 'featured' && item.dataset.featured === 'true') ||
          (item.dataset.themes ?? '').split('|').includes(theme);
        item.hidden = !match;
        if (match) visible++;
      });

      document.querySelectorAll<HTMLElement>('.talks-year-group').forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('.talk-item')).some(
          (i) => !i.hidden,
        );
      });

      const featuredSection = document.querySelector<HTMLElement>(
        '[data-talks-section="featured"]',
      );
      if (featuredSection) {
        featuredSection.hidden = !Array.from(
          featuredSection.querySelectorAll<HTMLElement>('.talk-item'),
        ).some((i) => !i.hidden);
      }

      const archiveSection = document.querySelector<HTMLElement>(
        '[data-talks-section="archive"]',
      );
      if (archiveSection) {
        archiveSection.hidden = !Array.from(
          archiveSection.querySelectorAll<HTMLElement>('.talks-year-group'),
        ).some((g) => !g.hidden);
      }

      liveRegion.textContent =
        theme === 'all'
          ? `Showing all ${totalCount} talks`
          : theme === 'featured'
          ? `Showing ${visible} featured ${visible === 1 ? 'talk' : 'talks'}`
          : `Showing ${visible} ${visible === 1 ? 'talk' : 'talks'} tagged ${theme}`;
    };

    filterBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.filter-chip');
      if (!btn) return;
      applyFilter(btn.dataset.theme ?? 'all');
    });
  }
</script>
