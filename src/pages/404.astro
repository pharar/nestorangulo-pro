---
import BaseLayout from '../layouts/BaseLayout.astro';

// Served for every unmatched path, so this page has no canonical URL of its
// own — `canonical={null}` omits the tag rather than pointing every 404 at /404/.
---

<BaseLayout
  title="Page not found — Nestor Angulo de Ugarte"
  description="That page doesn't exist. It may have been moved or renamed."
  canonical={null}
>
  <div class="container">
    <div class="page-header">
      <h1>Page not found</h1>
      <p>That page doesn't exist — it may have been moved or renamed.</p>
    </div>
    <div class="placeholder">
      <p class="placeholder-status">404</p>
      <a href="/" class="back-link">← Back to home</a>
    </div>
  </div>
</BaseLayout>
