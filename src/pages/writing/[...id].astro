---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../config';
import { getPublishedTalks } from '../../lib/talks';
import { getPublishedEssays } from '../../lib/writing';
import { essayNode, essayPostingId, essayUrl, talksLinkedFrom } from '../../lib/writingSchema';

export async function getStaticPaths() {
  const essays = await getPublishedEssays();
  return essays.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, subtitle, date, updated, summary, description, language, themes, cover, coverAlt } =
  entry.data;

const pageDescription = description ?? summary;
const ogImage = entry.data.ogImage ? `${SITE_URL}${entry.data.ogImage}` : undefined;
const structuredData = {
  breadcrumbs: [
    { name: 'Writing', url: `${SITE_URL}/writing/` },
    { name: title, url: essayUrl(entry.id) },
  ],
  mainEntity: essayPostingId(entry.id),
  nodes: [essayNode(entry, talksLinkedFrom(entry, await getPublishedTalks()))],
};

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title={`${title} — Nestor Angulo de Ugarte`}
  description={pageDescription}
  ogImage={ogImage}
  lang={language}
  structuredData={structuredData}
>
  <article class="container essay">
    <a href="/writing/" class="talk-back">
      ← Back to writing
    </a>

    <header class="talk-detail-header essay-header">
      <h1 class="talk-detail-title">{title}</h1>
      {subtitle && <p class="essay-subtitle">{subtitle}</p>}

      <div class="talk-detail-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Updated {formatDate(updated)}</span>}
      </div>

      {themes.length > 0 && (
        <ul class="talk-themes" aria-label="Themes">
          {themes.map((theme) => (
            <li class="theme-tag">{theme}</li>
          ))}
        </ul>
      )}
    </header>

    {cover && (
      <figure class="essay-cover">
        <Image src={cover} alt={coverAlt ?? ''} width={1200} loading="eager" />
      </figure>
    )}

    <div class="talk-detail-body essay-body">
      <Content />
    </div>
  </article>
</BaseLayout>
