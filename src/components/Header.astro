---
import Isotipo from './Isotipo.astro';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/writing/', label: 'Writing' },
  { href: '/speaking/', label: 'Speaking' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const { pathname } = Astro.url;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  // navItems hrefs end in '/', so a prefix match keeps the parent active on
  // nested pages (/speaking/ on /speaking/some-talk/) and cannot match /speakingX.
  return pathname.startsWith(href);
}
---

<!-- Skip-to-content: visually hidden until keyboard-focused -->
<a href="#main-content" class="skip-link">
  Skip to content
</a>

<header class="site-header">
  <div class="container container--wide">
    <a href="/" class="site-logo" aria-label="Nestor Angulo de Ugarte — home">
      {/*
          The logos are inlined rather than <img src>, so the dark strokes can
          follow `currentColor` and flip with the theme. `.site-logo` sets
          `color: var(--clr-text)`, so they theme themselves; the #c08c50 gold is
          fixed brand colour and stays put in both themes.

          Source of truth remains public/images/*.svg (favicon + OG generation
          still read them). If you edit the mark there, mirror it here.
        */}
      <svg
        class="site-logo-imagotipo"
        viewBox="0 0 950 175"
        width="217"
        height="40"
        aria-hidden="true"
        focusable="false"
      >
        <g transform="translate(12,10) scale(0.8959)">
          <path
            fill="currentColor"
            d="M 104.38 94.93 A 0.49 0.49 0.0 0 1 104.78 94.14 Q 105.70 94.19 118.25 93.89 C 125.06 93.73 133.74 90.51 139.17 86.05 C 161.31 67.89 155.80 29.28 127.41 20.24 Q 122.42 18.65 110.80 18.66 Q 87.80 18.66 73.72 18.72 A 2.11 2.10 -19.8 0 1 72.10 17.96 L 63.30 7.24 A 0.43 0.43 0.0 0 1 63.63 6.54 Q 104.47 6.49 108.41 6.41 Q 122.78 6.14 130.72 8.13 Q 146.06 11.98 156.98 26.61 C 163.36 35.15 165.91 48.03 165.54 57.97 C 164.81 77.51 155.22 93.46 137.35 101.91 Q 133.93 103.52 129.81 104.36 A 0.55 0.55 0.0 0 0 129.49 105.25 L 177.52 163.77 A 0.40 0.39 70.2 0 1 177.22 164.42 L 162.11 164.42 A 1.47 1.45 70.2 0 1 160.98 163.88 L 104.38 94.93 Z"
          ></path>
          <path
            fill="currentColor"
            d="M 19.38 120.20 A 0.37 0.37 0.0 0 1 18.74 120.46 L 7.30 108.43 A 3.19 3.16 23.4 0 1 6.43 106.25 L 6.43 7.93 A 0.40 0.40 0.0 0 1 7.14 7.67 L 140.24 163.66 A 0.51 0.51 0.0 0 1 139.85 164.51 L 124.70 164.51 A 1.17 1.17 0.0 0 1 123.82 164.11 Q 118.62 158.05 114.35 152.87 Q 109.65 147.19 107.69 145.12 C 104.30 141.55 101.96 138.03 98.84 134.65 C 91.76 126.98 85.73 119.31 78.58 111.04 C 70.85 102.11 65.68 95.57 59.15 88.37 C 53.95 82.64 49.03 76.29 44.08 70.85 C 35.45 61.35 28.45 52.49 20.03 43.25 A 0.37 0.37 0.0 0 0 19.38 43.50 L 19.38 120.20 Z"
          ></path>
          <path
            fill="#c08c50"
            d="M 45.74 164.46 L 29.79 164.46 A 0.32 0.32 0.0 0 1 29.56 164.36 L 6.60 140.22 A 0.32 0.32 0.0 0 1 6.51 140.00 L 6.51 123.22 A 0.32 0.32 0.0 0 1 7.06 123.00 L 45.98 163.92 A 0.32 0.32 0.0 0 1 45.74 164.46 Z"
          ></path>
        </g>

        {/* Divider: was a fixed light grey, now tints with the text colour. */}
        <line
          x1="190"
          y1="32"
          x2="190"
          y2="143"
          stroke="currentColor"
          stroke-opacity="0.3"
          stroke-width="1"
          stroke-linecap="square"
        ></line>

        <text
          font-family="Montserrat, 'Helvetica Neue', Arial, sans-serif"
          font-weight="300"
          font-size="78"
          y="118"
        >
          <tspan x="208" fill="currentColor">
            nestorangulo
          </tspan>
          <tspan fill="#c08c50">.pro</tspan>
        </text>
      </svg>

      <Isotipo class="site-logo-isotipo" width={43} height={40} />
    </a>
    <nav aria-label="Main navigation">
      <ul class="site-nav">
        {navItems.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
        <li class="site-nav-toggle">
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>
