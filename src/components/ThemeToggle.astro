---
// Light/dark switch for the header nav.
//
// Hidden unless `html.js` is set, which public/theme-init.js does before first
// paint: a visitor without JavaScript never sees a control that cannot work
// (the site still follows their OS preference via tokens.css), and a visitor
// with it sees the button in the first frame rather than popping in.
//
// theme-init.js reads the stored choice; the script below only writes it and
// keeps the button's accessible state in sync. It is a processed (bundled)
// script, not `is:inline`, so Astro covers it under the CSP automatically.
---

<button
  type="button"
  class="theme-toggle"
  aria-pressed="false"
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <svg
    class="theme-toggle-icon theme-toggle-icon--moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 13.2A8 8 0 1 1 10.8 4a6.6 6.6 0 0 0 9.2 9.2Z"></path>
  </svg>

  <svg
    class="theme-toggle-icon theme-toggle-icon--sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  (function () {
    // `const`, not `var`: the null check below only narrows the type for the
    // closures underneath if the binding cannot be reassigned.
    const btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    const root = document.documentElement;

    // With no explicit override the OS decides, so read the media query rather
    // than assuming light. Otherwise the first click would appear to do nothing
    // for a visitor already looking at the dark theme.
    //
    // These are const arrow functions rather than function declarations so the
    // `btn` null check above still narrows inside them — a hoisted declaration
    // could in principle run before the check, so TS refuses to narrow for it.
    const current = () =>
      root.dataset.theme ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    const sync = () => {
      const isDark = current() === 'dark';
      btn.setAttribute('aria-pressed', String(isDark));
      btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    };

    sync();

    btn.addEventListener('click', function () {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      sync();
    });
  })();
</script>
