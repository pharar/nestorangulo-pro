---
import { getPublishedTalks, talkCountRounded } from '../lib/talks';
import { useAbout } from '../i18n/ui/about';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useAbout(lang);

const rounded = talkCountRounded((await getPublishedTalks()).length);
const oneLiner = t('oneLiner', { rounded });
const shortBio = t('shortBio', { rounded });

// The copy-button script defaults to English; other languages hand over their
// strings as data attributes on the container.
const labels =
  lang === 'en'
    ? {}
    : {
        'data-copy-label': t('copy'),
        'data-copied-label': t('copied'),
        'data-copied-aria': t('copiedAria'),
        'data-fallback-aria': t('copyFallbackAria'),
      };
---

<div class="press" {...labels}>
  <div class="press-entry">
    <p class="press-entry-label">{t('oneLinerLabel')}</p>
    <blockquote class="press-block">
      <p>{oneLiner}</p>
      <button class="copy-btn" data-copy={oneLiner} aria-label={t('copyOneLinerAria')}>
        {t('copy')}
      </button>
    </blockquote>
  </div>

  <div class="press-entry">
    <p class="press-entry-label">{t('shortBioLabel')}</p>
    <blockquote class="press-block">
      <p>{shortBio}</p>
      <button class="copy-btn" data-copy={shortBio} aria-label={t('copyShortBioAria')}>
        {t('copy')}
      </button>
    </blockquote>
  </div>

  <div class="press-entry">
    <p class="press-entry-label">{t('photoLabel')}</p>
    <div class="press-photo-block">
      <a
        class="about-external-link"
        href="/images/photo-nestor-hires-a.jpg"
        download="nestor-angulo-de-ugarte.jpg"
      >
        {t('photoPortraitLink')}
      </a>
      <a
        class="about-external-link"
        href="/images/photo-nestor-hires-b.jpg"
        download="nestor-angulo-de-ugarte-athens.jpg"
      >
        {t('photoAthensLink')}
      </a>
      <p class="press-photo-note">{t('photoNote')}</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const ds = btn.closest<HTMLElement>('.press')?.dataset ?? {};
    const originalLabel = btn.getAttribute('aria-label') ?? ds.fallbackAria ?? 'Copy to clipboard';

    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';

      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Fallback: visually select the text so the user can Cmd+C manually
        const p = btn.closest<HTMLElement>('.press-block')?.querySelector('p');
        if (p) {
          const range = document.createRange();
          range.selectNodeContents(p);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }

      btn.textContent = ds.copiedLabel ?? 'Copied!';
      btn.classList.add('copy-btn--copied');
      btn.setAttribute('aria-label', ds.copiedAria ?? 'Copied to clipboard');

      setTimeout(() => {
        btn.textContent = ds.copyLabel ?? 'Copy';
        btn.classList.remove('copy-btn--copied');
        btn.setAttribute('aria-label', originalLabel);
      }, 2000);
    });
  });
</script>
