---
import { personSchema } from '../lib/person';
import { SITE_URL, DEFAULT_TITLE, DEFAULT_DESCRIPTION } from '../config';
import { ogLocale, metaDescription } from '../lib/meta';

interface Props {
  title?: string;
  description?: string;
  /** Pass null to omit the canonical entirely (see 404.astro). */
  canonical?: string | null;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** BCP-47 language of this page's content. Drives <html lang> and og:locale. */
  lang?: string;
  /** Pass true on the homepage and /about to emit Person structured data */
  person?: boolean;
}

const DEFAULT_OG_IMAGE = `${SITE_URL}/og-default.png`;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonical = Astro.url.href,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_OG_IMAGE,
  person = false,
  lang = 'en',
} = Astro.props;

const metaDesc = metaDescription(description);
const ogDesc = metaDescription(ogDescription);
---

<title>{title}</title>
<meta name="description" content={metaDesc} />
{canonical && <link rel="canonical" href={canonical} />}
<meta name="robots" content="index, follow" />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#faf9f7" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nestor Angulo de Ugarte" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDesc} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale(lang)} />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDesc} />
<meta name="twitter:image" content={ogImage} />

<!-- Person structured data (homepage and /about) -->
{person && <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
