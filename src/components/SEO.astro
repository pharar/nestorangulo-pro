---
import { pageGraph, type PageStructuredData } from '../lib/structuredData';
import { SITE_URL, DEFAULT_TITLE, DEFAULT_DESCRIPTION } from '../config';
import { ogLocale, metaDescription } from '../lib/meta';
import { absoluteUrl, markdownPathFor } from '../lib/ai/paths';
import { getMarkdownPages } from '../lib/ai/registry';

interface Props {
  title?: string;
  description?: string;
  /** Pass null to omit the canonical entirely (see 404.astro). */
  canonical?: string | null;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** BCP-47 language of this page's content. Drives <html lang> and og:locale. */
  lang?: string;
  /** Pass true on the homepage and /about to emit the full Person node */
  person?: boolean;
  /** This page's contribution to the JSON-LD @graph (page type, crumbs, nodes). */
  structuredData?: PageStructuredData;
}

const DEFAULT_OG_IMAGE = `${SITE_URL}/og-default.png`;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonical = Astro.url.href,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_OG_IMAGE,
  person = false,
  lang = 'en',
  structuredData = {},
} = Astro.props;

const metaDesc = metaDescription(description);
const ogDesc = metaDescription(ogDescription);

// Markdown twin (see src/lib/ai/paths.ts). Only advertised when the page has a
// canonical (not the 404) and the registry actually builds that `.md` file.
const mdPath = canonical === null ? null : markdownPathFor(Astro.url.pathname);
const markdownAlternate =
  mdPath && (await getMarkdownPages()).some((p) => p.mdPath === mdPath)
    ? absoluteUrl(mdPath)
    : null;

const graph = pageGraph({
  ...structuredData,
  url: canonical,
  name: title,
  description,
  lang,
  fullPerson: person,
});
---

<title>{title}</title>
<meta name="description" content={metaDesc} />
{canonical && <link rel="canonical" href={canonical} />}
{markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
<meta name="robots" content="index, follow" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1815" media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nestor Angulo de Ugarte" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDesc} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale(lang)} />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDesc} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured data: one @graph per page (see src/lib/structuredData.ts) -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}
></script>
