---
import { personSchema } from '../lib/person';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Pass true on the homepage and /about to emit Person structured data */
  person?: boolean;
}

const SITE_URL = 'https://nestorangulo.pro';

const DEFAULT_TITLE = 'Nestor Angulo de Ugarte — Head of Security · CISSP';

const DEFAULT_DESCRIPTION =
  'Head of Security and CISSP. I build security programs from zero — vulnerability intelligence, incident response, ISO 27001 and SOC 2.';

const DEFAULT_OG_IMAGE = `${SITE_URL}/og-default.png`;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonical = Astro.url.href,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_OG_IMAGE,
  person = false,
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#faf9f7" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nestor Angulo de Ugarte" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- Person structured data (homepage and /about) -->
{person && <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
