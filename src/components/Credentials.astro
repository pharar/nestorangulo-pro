---
import { credentials } from '../data/credentials';
import { useAbout } from '../i18n/ui/about';
import { localized } from '../i18n/localized';
import { formatYearMonth } from '../lib/yearMonth';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useAbout(lang);
---

<ul class="credentials-list">
  {credentials.map((c) => (
    <li class="credential-item">
      <div class="credential-header">
        <span class="credential-title">{localized(c.title, lang)}</span>
        {c.verifyUrl && (
          <a
            class="credential-verify"
            href={c.verifyUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('verifyAria', { title: localized(c.title, lang) })}
          >
            {t('verifyLink')}
          </a>
        )}
      </div>
      <div class="credential-meta">
        <span class="credential-issuer">{c.issuer}</span>
        {c.type && <span class="credential-badge">{localized(c.type, lang)}</span>}
        {c.eqfLevel && <span class="credential-eqf">{t('eqf', { n: c.eqfLevel })}</span>}
        {c.validUntil && (
          <span class="credential-date">
            {t('validUntil', { date: formatYearMonth(c.validUntil, lang) })}
          </span>
        )}
        {c.yearCompleted && <span class="credential-date">{c.yearCompleted}</span>}
        {c.since && (
          <span class="credential-date">
            {t('since', { date: formatYearMonth(c.since, lang) })}
          </span>
        )}
      </div>
      {c.note && <p class="credential-note">{localized(c.note, lang)}</p>}
    </li>
  ))}
</ul>
