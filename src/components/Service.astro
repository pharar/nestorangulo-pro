---
import { serviceRoles } from '../data/service';
import { useAbout } from '../i18n/ui/about';
import { localized } from '../i18n/localized';
import { formatYearMonth } from '../lib/yearMonth';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useAbout(lang);
---

<ul class="service-list">
  {serviceRoles.map((r) => (
    <li class="service-item">
      <div class="service-main">
        <p class="service-role">{r.title}</p>
        <p class="service-org">{r.organization}</p>
        {r.type && <p class="service-badge">{localized(r.type, lang)}</p>}
      </div>
      <div class="service-date-col">
        {r.since && !r.until && (
          <span class="service-date">{t('since', { date: formatYearMonth(r.since, lang) })}</span>
        )}
        {r.since && r.until && (
          <span class="service-date">
            {formatYearMonth(r.since, lang)} – {formatYearMonth(r.until, lang)}
          </span>
        )}
      </div>
      {r.note && <p class="service-note">{localized(r.note, lang)}</p>}
    </li>
  ))}
</ul>
