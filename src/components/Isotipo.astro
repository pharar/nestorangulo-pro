---
// The NR mark on its own, inlined so the dark strokes follow `currentColor` and
// flip with the theme. Used by the header (mobile logo) and the footer.
//
// Trimmed from public/images/isotipo-nestorangulo-pro.svg, which additionally
// carries an opaque #fbfafb backing rectangle — invisible on the light
// background, a white box on the dark one — plus two antialiasing stroke
// overlays that read as grey halos in dark. Only the mark itself is kept.
// That file is still the source of truth for the favicon and OG generation; if
// you edit the mark there, mirror it here.

interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { class: className, width = 43, height = 40 } = Astro.props;
---

