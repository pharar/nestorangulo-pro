---
import { publications } from '../data/publications';
import { useAbout } from '../i18n/ui/about';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useAbout(lang);

const typeLabels: Record<string, string> = {
  book_chapter: t('pubBookChapter'),
  conference_paper: t('pubConferencePaper'),
};

// English: "A, B, & C" (APA); Spanish: "A, B y C".
function formatAuthors(coAuthors: string[]): string {
  if (coAuthors.length === 0) return '';
  const last = coAuthors[coAuthors.length - 1];
  const rest = coAuthors.slice(0, -1);
  if (lang === 'es') {
    return rest.length === 0
      ? ` ${t('pubAnd')} ${last}`
      : `, ${rest.join(', ')} ${t('pubAnd')} ${last}`;
  }
  if (coAuthors.length === 1) return `, & ${coAuthors[0]}`;
  return `, ${rest.join(', ')}, & ${last}`;
}
---

<ol class="publications-list">
  {publications.map((p) => (
    <li class="publication-item">
      <p class="publication-authors">
        Angulo de Ugarte, N.
        {p.coAuthors && p.coAuthors.length > 0 && formatAuthors(p.coAuthors)} ({p.year}).
      </p>
      <p class="publication-title">
        {p.title}.{' '}
        {p.in && (
          <>
            {t('pubIn')} <em>{p.in}</em>.{' '}
          </>
        )}
        {p.venue && (
          <>
            <em>{p.venue}</em>.{' '}
          </>
        )}
        {p.publisher && <>{p.publisher}. </>}
        {p.isbn && <>ISBN {p.isbn}.</>}
      </p>
      <span class="publication-type">{typeLabels[p.type] ?? p.type}</span>
    </li>
  ))}
</ol>
