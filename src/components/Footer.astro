---
import Isotipo from './Isotipo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <p class="footer-copy">
      <Isotipo class="footer-mark" width={32} height={30} />
      &copy; {year} nestorangulo.pro
    </p>
    <ul class="footer-links">
      <li>
        <a href="https://linkedin.com/in/pharar" target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
      </li>
      <li>
        <a href="/contact/">Contact</a>
      </li>
      <li>
        <a
          href="https://github.com/pharar/nestorangulo-pro"
          target="_blank"
          rel="noopener noreferrer"
        >
          Source
        </a>
      </li>
    </ul>
  </div>
</footer>
