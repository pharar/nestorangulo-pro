---
import Isotipo from './Isotipo.astro';
import { useCommon } from '../i18n/ui/common';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/config';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? 'en';
const t = useCommon(lang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <p class="footer-copy">
      <Isotipo class="footer-mark" width={32} height={30} />
      &copy; {year} nestorangulo.pro
    </p>
    <ul class="footer-links">
      <li>
        <a href="https://linkedin.com/in/pharar" target="_blank" rel="noopener noreferrer">
          {t('footerLinkedin')}
        </a>
      </li>
      <li>
        <a href={localizePath('/contact/', lang)}>{t('footerContact')}</a>
      </li>
      <li>
        <a
          href="https://github.com/pharar/nestorangulo-pro"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('footerSource')}
        </a>
      </li>
    </ul>
  </div>
</footer>
