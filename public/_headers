/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Astro content-hashes everything it emits here — CSS, JS and the Fraunces
# woff2 subsets. The filename changes whenever the bytes do, so these can never
# go stale and a repeat visitor should never re-request them.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# NOT hashed: these filenames survive a redesign, so `immutable` would strand a
# replaced logo or photo in caches for a year. Cache for a day, then revalidate.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/og-default.png
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# ── AI-readable layer ──────────────────────────────────────────────────────
# Not hashed and regenerated on every build, so the same day-then-revalidate
# policy as the images. Pages would guess a Content-Type from the extension;
# pinning it (with the charset) stops a browser or agent from mis-decoding
# the em dashes and accented names as Latin-1.

# llms.txt is meant to be discovered, so it is NOT noindexed.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

# The Markdown twins of each page (/about.md, /speaking/<id>.md, …). The splat
# matches greedily across `/`, so this one rule covers nested twins too.
# `noindex` keeps them out of search results so they never compete with the
# canonical HTML page — but they stay crawlable (robots.txt allows them),
# which is all an AI agent needs. No `Link: rel="canonical"` header: the HTML
# page already advertises the twin via <link rel="alternate">, and noindex
# already settles which URL ranks. `:splat` could build one, but /index.md
# would map to /index/, and matching rules stack rather than override, so
# there is no clean exception for the home page.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=86400, must-revalidate
